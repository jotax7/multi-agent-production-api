# ---------- LLM (elegí UN proveedor) ----------
# Recomendado para esta entrega: openai + gpt-4o-mini -> Phoenix ya conoce su precio y calcula el costo solo.
LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# Reintentos del cliente LLM ante 429 / 5xx (se pasa como max_retries a ChatGoogleGenerativeAI y ChatGroq).
# LLM_MAX_RETRIES=6
OPENAI_API_KEY=
# GROQ_API_KEY=          (LLM_PROVIDER=groq)
# GOOGLE_API_KEY=        (LLM_PROVIDER=gemini   — también acepta GEMINI_API_KEY)
# ANTHROPIC_API_KEY=     (LLM_PROVIDER=anthropic)

# ---------- Redis (Redis STACK) ----------
REDIS_URL=redis://localhost:6379

# ---------- Observabilidad ----------
# phoenix | langsmith | none
OBSERVABILITY=phoenix
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT_NAME=multi-agent-api
# Phoenix Cloud (opcional): PHOENIX_API_KEY=... y PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com/s/<tu-space>

# Si usás LangSmith (OBSERVABILITY=langsmith):
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=multi-agent-api

# ---------- Límites (opcionales) ----------
# MAX_CONCURRENT_JOBS=10        # jobs simultáneos por proceso
# JOB_TIMEOUT_SECONDS=300       # pasado este tiempo el job queda FAILED
# JOB_TTL_SECONDS=86400         # cuánto vive el estado del job en Redis
# CHECKPOINT_TTL_MINUTES=1440   # cuánto viven los checkpoints
# OUTBOX_PATH=outbox.jsonl      # donde las tools "críticas" simuladas anotan lo que ejecutaron
# TAVILY_API_KEY=               # búsqueda web real (opcional)
